# Start Here still works if the AI layer is unavailable.
# Plan changes and common Coach questions have a deterministic/local fallback.

# On Vercel, Start Here Coach uses Vercel AI Gateway through the deployment's OIDC identity,
# so a separate provider API key is not required for the normal deployed path.

# Optional: choose a different AI Gateway model.
START_HERE_COACH_MODEL=openai/gpt-5.6-sol

# Optional for local/non-Vercel development if you want to call AI Gateway outside Vercel OIDC.
AI_GATEWAY_API_KEY=

# Optional cloud accounts and cross-device backup. The publishable key is safe for the
# browser; access to each snapshot is still restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

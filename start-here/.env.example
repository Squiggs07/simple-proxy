# Start Here runs without AI configuration.
# The app will fall back to its deterministic local Coach action layer.

# Optional: enables semantic normalization of free-form Coach requests.
ANTHROPIC_API_KEY=

# Optional: override the semantic normalization model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Legacy backend/auth routes remain in the repository but are not required
# for the current local-first Start Here product experience on `/`.
# Add database/auth variables only when those legacy routes are intentionally enabled.
